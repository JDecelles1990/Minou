; ==============================================================================
; Minou - Advanced Dark Theme F3 Popup Menu & Quick Launcher for AutoHotkey v2
; ==============================================================================
#Requires AutoHotkey v2.0
#SingleInstance Force
Persistent

; Set coordinate mode for menus to absolute screen coordinates
CoordMode "Menu", "Screen"
CoordMode "Mouse", "Screen"

; Global Variables
global ScriptTitle := "Minou AHK Menu"
global ConfigFile := A_ScriptDir . "\config.json"
global ConfigData := Map()
global AllSearchItems := []
global DynamicScriptHandles := Map()

; Initialize Menu & Theme
InitMinou()

; ==============================================================================
; Core Initialization & Config Setup
; ==============================================================================
InitMinou(params*) {
    global ConfigData
    SetMenuDarkMode()
    LoadConfiguration()
    RegisterHotkeys()
    SetupTrayMenu()
}

SetMenuDarkMode(params*) {
    try {
        uxtheme := DllCall("GetModuleHandle", "str", "uxtheme", "ptr")
        if (!uxtheme)
            uxtheme := DllCall("LoadLibrary", "str", "uxtheme", "ptr")
        if (uxtheme) {
            ; SetPreferredAppMode: ordinal 135 (2 = ForceDark)
            SetPreferredAppMode := DllCall("GetProcAddress", "ptr", uxtheme, "ptr", 135, "ptr")
            if (SetPreferredAppMode)
                DllCall(SetPreferredAppMode, "int", 2)
            
            ; FlushMenuThemes: ordinal 136
            FlushMenuThemes := DllCall("GetProcAddress", "ptr", uxtheme, "ptr", 136, "ptr")
            if (FlushMenuThemes)
                DllCall(FlushMenuThemes)
        }
    } catch {
        ; Ignore theme errors on non-supported OS builds
    }
}

LoadConfiguration(params*) {
    global ConfigData, ConfigFile
    if (!FileExist(ConfigFile)) {
        MsgBox("Configuration file not found at:`n" . ConfigFile . "`nPlease ensure config.json is in the script directory.", ScriptTitle, "Icon!")
        return
    }
    
    try {
        rawJson := FileRead(ConfigFile, "UTF-8")
        ConfigData := JSONParse(rawJson)
    } catch Error as err {
        MsgBox("Failed to load JSON configuration:`n" . err.Message, ScriptTitle, "Icon!")
    }
}

RegisterHotkeys(params*) {
    global ConfigData
    try {
        mainKey := "F3"
        searchKey := "+F3"
        
        if (ConfigData.Has("settings")) {
            settings := ConfigData["settings"]
            if (settings.Has("hotkey") && settings["hotkey"] != "")
                mainKey := settings["hotkey"]
            if (settings.Has("searchHotkey") && settings["searchHotkey"] != "")
                searchKey := settings["searchHotkey"]
        }
        
        Hotkey(mainKey, ShowMainMenu)
        Hotkey(searchKey, ShowSearchGUI)
    } catch Error as err {
        MsgBox("Error registering hotkeys: " . err.Message, ScriptTitle, "Icon!")
    }
}

SetupTrayMenu(params*) {
    Tray := A_TrayMenu
    Tray.Delete()
    Tray.Add("Show Menu (F3)", (a:="", b:="", c:="") => ShowMainMenu())
    Tray.Add("Search Launcher (Shift+F3)", (a:="", b:="", c:="") => ShowSearchGUI())
    Tray.Add()
    Tray.Add("Edit config.json", (a:="", b:="", c:="") => SafeRun("notepad.exe", '"' . ConfigFile . '"'))
    Tray.Add("Reload Script", (a:="", b:="", c:="") => Reload())
    Tray.Add("Exit", (a:="", b:="", c:="") => ExitApp())
    A_IconTip := "Minou AHK Menu (F3)"
}

; ==============================================================================
; Safe Launcher Fallback (Application Control / WDAC Protection Bypass)
; ==============================================================================
SafeRun(target, args := "", params*) {
    expandedTarget := ExpandEnvVars(target)
    strArgs := String(args)
    
    try {
        ; Primary launch via Shell.Application to completely bypass AHK's RunWithHandles WDAC block
        ComObject("Shell.Application").ShellExecute(expandedTarget, strArgs, "", "open", 1)
    } catch Error as err {
        try {
            if (strArgs != "") {
                Run(expandedTarget . " " . strArgs)
            } else {
                Run(expandedTarget)
            }
        } catch Error as e {
            MsgBox("Could not launch '" . target . "'.`n`nIf this application is installed in a non-standard location, please edit its path in config.json.", ScriptTitle, "Icon!")
        }
    }
}

; ==============================================================================
; Menu Creation & Rendering
; ==============================================================================
ShowMainMenu(params*) {
    global AllSearchItems
    AllSearchItems := [] ; Refresh searchable database
    
    mainMenu := Menu()
    
    ; 1. Search Launcher Top Entry
    mainMenu.Add("🔍 Search / Quick Filter (Shift+F3)", (a:="", b:="", c:="") => ShowSearchGUI())
    mainMenu.Add() ; Separator

    ; 2. URLs Submenu
    if (ConfigData.Has("urls"))
        mainMenu.Add("🌐 URLs", BuildURLsMenu(ConfigData["urls"]))
        
    ; 3. AI Tools Submenu
    if (ConfigData.Has("ai_tools"))
        mainMenu.Add("🤖 AI Tools", BuildAIToolsMenu(ConfigData["ai_tools"]))
        
    ; 4. Programs Submenu
    if (ConfigData.Has("programs"))
        mainMenu.Add("🚀 Programs", BuildProgramsMenu(ConfigData["programs"]))
        
    ; 5. Running Scripts Submenu (Dynamic)
    mainMenu.Add("📜 Running Scripts", BuildRunningScriptsMenu())
    
    ; 6. Folders Submenu
    if (ConfigData.Has("folders"))
        mainMenu.Add("📁 Folders", BuildFoldersMenu(ConfigData["folders"]))
        
    ; 7. Text Shortcuts Submenu
    if (ConfigData.Has("text_shortcuts"))
        mainMenu.Add("✂ Text Shortcuts", BuildTextShortcutsMenu(ConfigData["text_shortcuts"]))
        
    ; 8. Autofill Submenu
    if (ConfigData.Has("autofill"))
        mainMenu.Add("⌨ Autofill Text", BuildAutofillMenu(ConfigData["autofill"]))
        
    ; 9. Windows Settings Submenu
    if (ConfigData.Has("win_settings"))
        mainMenu.Add("🪟 Windows Settings", BuildWinSettingsMenu(ConfigData["win_settings"]))
        
    ; 10. PowerShell Submenu
    if (ConfigData.Has("powershell_snippets"))
        mainMenu.Add("💻 PowerShell", BuildPowerShellMenu(ConfigData["powershell_snippets"]))
        
    ; 11. LLM Prompts Submenu
    if (ConfigData.Has("llm_prompts"))
        mainMenu.Add("📋 LLM Prompts", BuildLLMPromptsMenu(ConfigData["llm_prompts"]))
        
    ; 12. Utilities Submenu
    if (ConfigData.Has("utilities"))
        mainMenu.Add("🧰 Utilities", BuildUtilitiesMenu(ConfigData["utilities"]))
        
    mainMenu.Add() ; Separator
    
    ; 13. Edit & Settings Submenu
    mainMenu.Add("⚙ Edit & Settings", BuildSettingsMenu())
    
    ; 14. Exit
    mainMenu.Add("❌ Exit Menu", (a:="", b:="", c:="") => "")
    
    ; Popup at current mouse position
    MouseGetPos(&mouseX, &mouseY)
    mainMenu.Show(mouseX, mouseY)
}

; --- Submenu Builders ---

BuildURLsMenu(urlsGroup, params*) {
    m := Menu()
    for catName, items in urlsGroup {
        sub := Menu()
        for item in items {
            itemName := item["name"]
            itemUrl := item["url"]
            sub.Add(itemName, CreateURLCallback(itemUrl))
            RegisterSearchItem(itemName, "URL", catName, (a:="", b:="", c:="") => SafeRun(itemUrl))
        }
        m.Add(catName, sub)
    }
    return m
}

BuildAIToolsMenu(aiGroup, params*) {
    m := Menu()
    for catName, items in aiGroup {
        sub := Menu()
        for item in items {
            itemName := item["name"]
            if (item.Has("url")) {
                targetUrl := item["url"]
                sub.Add(itemName, CreateURLCallback(targetUrl))
                RegisterSearchItem(itemName, "AI Tool", catName, (a:="", b:="", c:="") => SafeRun(targetUrl))
            } else if (item.Has("cmd")) {
                targetCmd := item["cmd"]
                sub.Add(itemName, CreateCmdCallback(targetCmd))
                RegisterSearchItem(itemName, "AI Desktop App", catName, (a:="", b:="", c:="") => RunCmdOrSend(targetCmd))
            }
        }
        m.Add(catName, sub)
    }
    return m
}

BuildProgramsMenu(progList, params*) {
    m := Menu()
    for item in progList {
        itemName := item["name"]
        itemPath := item["path"]
        m.Add(itemName, CreateCmdCallback(itemPath))
        RegisterSearchItem(itemName, "Program", "Programs", (a:="", b:="", c:="") => RunCmdOrSend(itemPath))
    }
    return m
}

BuildRunningScriptsMenu(params*) {
    m := Menu()
    global DynamicScriptHandles
    DynamicScriptHandles := Map()
    
    DetectHiddenWindows(true)
    winList := WinGetList("ahk_class AutoHotkey")
    
    count := 0
    for hwnd in winList {
        try {
            winTitle := WinGetTitle("ahk_id " . hwnd)
            if (RegExMatch(winTitle, "^(.*?\.(?:ahk|exe))", &match)) {
                scriptName := match[1]
                ; Avoid adding our own script control options to the list
                if (hwnd != A_ScriptHwnd) {
                    count++
                    sub := Menu()
                    sub.Add("Reload Script", CreateScriptActionCallback(hwnd, "Reload"))
                    sub.Add("Suspend Script", CreateScriptActionCallback(hwnd, "Suspend"))
                    sub.Add("Kill Process", CreateScriptActionCallback(hwnd, "Kill"))
                    m.Add(scriptName, sub)
                    RegisterSearchItem(scriptName, "Running Script", "AHK", (a:="", b:="", c:="") => WinActivate("ahk_id " . hwnd))
                }
            }
        }
    }
    
    if (count == 0) {
        m.Add("(No other AHK scripts running)", (a:="", b:="", c:="") => "")
        m.Disable("(No other AHK scripts running)")
    }
    
    m.Add() ; Separator
    m.Add("🔄 Reload All Scripts", (a:="", b:="", c:="") => ControlAllAHKScripts("Reload"))
    m.Add("⏸ Suspend All Scripts", (a:="", b:="", c:="") => ControlAllAHKScripts("Suspend"))
    m.Add("⛔ Kill All Other Scripts", (a:="", b:="", c:="") => ControlAllAHKScripts("Kill"))
    return m
}

BuildFoldersMenu(folderList, params*) {
    m := Menu()
