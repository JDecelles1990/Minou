; ==============================================================================
; Helper Actions & Callbacks
; ==============================================================================
CreateURLCallback(url, params*) {
    return (a:="", b:="", c:="") => SafeRun(url)
}

CreateCmdCallback(cmd, params*) {
    return (a:="", b:="", c:="") => RunCmdOrSend(cmd)
}

RunCmdOrSend(cmd, params*) {
    if (SubStr(cmd, 1, 5) = "send:") {
        sendKeys := SubStr(cmd, 6)
        Send(sendKeys)
    } else {
        SafeRun(cmd)
    }
}

CreateFolderCallback(folderPath, params*) {
    return (a:="", b:="", c:="") => SafeRun("explorer.exe", '"' . folderPath . '"')
}

CreatePasteCallback(txt, params*) {
    return (a:="", b:="", c:="") => PasteText(txt)
}

PasteText(txt, params*) {
    ; Replace dynamic variables
    formattedTxt := StrReplace(txt, "{DATE}", FormatTime(, "yyyy-MM-dd"))
    formattedTxt := StrReplace(formattedTxt, "{TIME}", FormatTime(, "HH:mm:ss"))
    
    oldClip := A_Clipboard
    A_Clipboard := formattedTxt
    if (ClipWait(1)) {
        Send("^v")
        ; Restore clipboard shortly after
        SetTimer((a:="", b:="") => (A_Clipboard := oldClip), -1000)
    }
}

CreateTextActionCallback(act, params*) {
    return (a:="", b:="", c:="") => HandleTextAction(act)
}

HandleTextAction(act, params*) {
    if (act = "date") {
        PasteText(FormatTime(, "yyyy-MM-dd"))
    } else if (act = "timestamp") {
        PasteText(FormatTime(, "yyyy-MM-dd HH:mm:ss"))
    } else if (act = "urlencode") {
        if (A_Clipboard != "") {
            encoded := UrlEncode(A_Clipboard)
            A_Clipboard := encoded
            ToolTip("URL Encoded Clipboard!")
            SetTimer((a:="", b:="") => ToolTip(), -2000)
        }
    } else if (act = "base64") {
        if (A_Clipboard != "") {
            encoded := Base64Encode(A_Clipboard)
            A_Clipboard := encoded
            ToolTip("Base64 Encoded Clipboard!")
            SetTimer((a:="", b:="") => ToolTip(), -2000)
        }
    }
}

CopyLLMPrompt(name, promptText, params*) {
    A_Clipboard := promptText
    ToolTip("Copied LLM Prompt [" . name . "] to clipboard!")
    SetTimer((a:="", b:="") => ToolTip(), -2000)
}

CreateScriptActionCallback(hwnd, action, params*) {
    return (a:="", b:="", c:="") => ControlSingleScript(hwnd, action)
}

ControlSingleScript(hwnd, action, params*) {
    if (action = "Reload") {
        PostMessage(0x0111, 65303, 0,, "ahk_id " . hwnd) ; WM_COMMAND 65303 = Reload
        ToolTip("Reload sent to script window!")
    } else if (action = "Suspend") {
        PostMessage(0x0111, 65305, 0,, "ahk_id " . hwnd) ; WM_COMMAND 65305 = Suspend
        ToolTip("Suspend sent to script window!")
    } else if (action = "Kill") {
        WinKill("ahk_id " . hwnd)
        ToolTip("Kill command sent to process!")
    }
    SetTimer((a:="", b:="") => ToolTip(), -2000)
}

ControlAllAHKScripts(action, params*) {
    DetectHiddenWindows(true)
    winList := WinGetList("ahk_class AutoHotkey")
    for hwnd in winList {
        if (hwnd != A_ScriptHwnd) {
            ControlSingleScript(hwnd, action)
        }
    }
}

ExpandEnvVars(path, params*) {
    expanded := path
    if (InStr(path, "%A_ScriptDir%"))
        expanded := StrReplace(expanded, "%A_ScriptDir%", A_ScriptDir)
    if (InStr(path, "%TEMP%"))
        expanded := StrReplace(expanded, "%TEMP%", EnvGet("TEMP"))
    if (InStr(path, "%USERPROFILE%"))
        expanded := StrReplace(expanded, "%USERPROFILE%", EnvGet("USERPROFILE"))
    if (InStr(path, "%LOCALAPPDATA%"))
        expanded := StrReplace(expanded, "%LOCALAPPDATA%", EnvGet("LOCALAPPDATA"))
    if (InStr(path, "%APPDATA%"))
        expanded := StrReplace(expanded, "%APPDATA%", EnvGet("APPDATA"))
    if (InStr(path, "%ProgramFiles%"))
        expanded := StrReplace(expanded, "%ProgramFiles%", EnvGet("ProgramFiles"))
    return expanded
}

RegisterSearchItem(name, type, cat, execFunc, params*) {
    global AllSearchItems
    AllSearchItems.Push({ name: name, type: type, cat: cat, exec: execFunc })
}

; ==============================================================================
; Search & Filter GUI Component (Shift+F3)
; ==============================================================================
global SearchGUI := ""
global SearchEdit := ""
global SearchLV := ""
global FilteredItems := []

ShowSearchGUI(params*) {
    global SearchGUI, SearchEdit, SearchLV, FilteredItems, AllSearchItems
    
    if (SearchGUI != "") {
        SearchGUI.Destroy()
    }
    
    ; Create dark styled GUI window
    SearchGUI := Gui("+AlwaysOnTop +Owner -MinimizeBox", "Minou Quick Search & Filter (Press Esc to Close)")
    SearchGUI.BackColor := "0x1E1E1E"
    SearchGUI.SetFont("s10 cWhite", "Segoe UI")
    
    SearchGUI.Add("Text", "x15 y12 w350 cGray", "Type to filter commands, URLs, scripts, and snippets:")
    SearchEdit := SearchGUI.Add("Edit", "x15 y35 w570 h30 Background0x2D2D2D cWhite -E0x200")
    SearchEdit.OnEvent("Change", OnSearchChange)
    SearchEdit.OnEvent("KeyDown", OnSearchKeyDown)
    
    SearchLV := SearchGUI.Add("ListView", "x15 y75 w570 h350 Background0x252526 cWhite Grid", ["Item Name", "Category", "Type"])
    SearchLV.ModifyCol(1, 280)
    SearchLV.ModifyCol(2, 160)
    SearchLV.ModifyCol(3, 110)
    SearchLV.OnEvent("DoubleClick", OnSearchSelect)
    
    SearchGUI.Add("Button", "x15 y435 w100 h30 Default", "Execute").OnEvent("Click", OnSearchSelect)
    SearchGUI.Add("Button", "x485 y435 w100 h30", "Close").OnEvent("Click", (a:="", b:="", c:="") => SearchGUI.Hide())
    
    ; Populate initially
    OnSearchChange()
    
    SearchGUI.Show("w600 h480 Center")
}

OnSearchKeyDown(ctrl, info) {
    if (info.Key = "Escape") {
        SearchGUI.Hide()
    } else if (info.Key = "Enter") {
        OnSearchSelect()
    }
}

OnSearchChange(params*) {
    global SearchEdit, SearchLV, FilteredItems, AllSearchItems
    query := Trim(SearchEdit.Value)
    
    SearchLV.Delete()
    FilteredItems := []
    
    for item in AllSearchItems {
        if (query == "" || InStr(item.name, query) || InStr(item.cat, query) || InStr(item.type, query)) {
            FilteredItems.Push(item)
            SearchLV.Add("", item.name, item.cat, item.type)
        }
    }
}

OnSearchSelect(params*) {
    global SearchLV, FilteredItems, SearchGUI
    row := SearchLV.GetNext(0)
    if (row > 0 && row <= FilteredItems.Length) {
        selectedItem := FilteredItems[row]
        SearchGUI.Hide()
        try {
            selectedItem.exec()
        } catch Error as err {
            MsgBox("Execution error: " . err.Message, ScriptTitle, "Icon!")
        }
    }
}

; ==============================================================================
; Pure AutoHotkey v2 JSON Parser Implementation
; ==============================================================================
JSONParse(src, params*) {
    src := Trim(src)
    pos := 1
    length := StrLen(src)
    
    SkipWhitespace() {
        while (pos <= length) {
            ch := SubStr(src, pos, 1)
            if (ch = " " || ch = "`t" || ch = "`r" || ch = "`n")
                pos++
            else
                break
        }
    }

    ParseValue() {
        SkipWhitespace()
        if (pos > length)
            return ""
        ch := SubStr(src, pos, 1)
        if (ch = "{")
            return ParseObject()
        else if (ch = "[")
            return ParseArray()
        else if (ch = '"')
            return ParseString()
        else if (ch = "t" || ch = "f")
            return ParseBoolean()
        else if (ch = "n")
            return ParseNull()
        else if (RegExMatch(ch, "[\d\-.]"))
            return ParseNumber()
        throw Error("JSON Parse Error at position " pos ": " ch)
    }

    ParseObject() {
        pos++ ; skip {
        obj := Map()
        SkipWhitespace()
        if (SubStr(src, pos, 1) = "}") {
            pos++
            return obj
        }
        loop {
            SkipWhitespace()
            if (SubStr(src, pos, 1) != '"')
                throw Error("Expected string key at position " pos)
            key := ParseString()
            SkipWhitespace()
            if (SubStr(src, pos, 1) != ":")
                throw Error("Expected ':' at position " pos)
            pos++
            val := ParseValue()
            obj[key] := val
            SkipWhitespace()
            ch := SubStr(src, pos, 1)
            if (ch = "}") {
                pos++
                break
            } else if (ch = ",") {
                pos++
            } else {
                throw Error("Expected ',' or '}' at position " pos)
            }
        }
        return obj
    }

    ParseArray() {
        pos++ ; skip [
        arr := []
        SkipWhitespace()
        if (SubStr(src, pos, 1) = "]") {
            pos++
            return arr
        }
        loop {
            arr.Push(ParseValue())
            SkipWhitespace()
            ch := SubStr(src, pos, 1)
            if (ch = "]") {
                pos++
                break
            } else if (ch = ",") {
                pos++
            } else {
                throw Error("Expected ',' or ']' at position " pos)
            }
        }
        return arr
    }

    ParseString() {
        pos++ ; skip opening quote
        str := ""
        while (pos <= length) {
            ch := SubStr(src, pos, 1)
            if (ch = '"') {
                pos++
                return str
            } else if (ch = "\") {
                pos++
                if (pos > length) {
                    break
                }
                esc := SubStr(src, pos, 1)
                if (esc = '"' || esc = "\" || esc = "/") {
                    str .= esc
                } else if (esc = "b") {
                    str .= "`b"
                } else if (esc = "f") {
                    str .= "`f"
                } else if (esc = "n") {
                    str .= "`n"
                } else if (esc = "r") {
                    str .= "`r"
                } else if (esc = "t") {
                    str .= "`t"
                } else if (esc = "u") {
                    hex := SubStr(src, pos + 1, 4)
                    pos += 4
                    str .= Chr(Integer("0x" hex))
                } else {
                    str .= esc
                }
            } else {
                str .= ch
            }
            pos++
        }
        return str
    }

    ParseBoolean() {
        if (SubStr(src, pos, 4) = "true") {
            pos += 4
            return true
        } else if (SubStr(src, pos, 5) = "false") {
            pos += 5
            return false
        }
        throw Error("Invalid boolean at position " pos)
    }

    ParseNull() {
        if (SubStr(src, pos, 4) = "null") {
            pos += 4
            return ""
        }
        throw Error("Invalid null at position " pos)
    }

    ParseNumber() {
        start := pos
        while (pos <= length && RegExMatch(SubStr(src, pos, 1), "[\d\-+.eE]"))
            pos++
        numStr := SubStr(src, start, pos - start)
        return InStr(numStr, ".") ? Float(numStr) : Integer(numStr)
    }

    return ParseValue()
}

; Utility encoders
UrlEncode(str, params*) {
    buf := Buffer(StrPut(str, "UTF-8"))
    StrPut(str, buf, "UTF-8")
    res := ""
    loop buf.Size - 1 {
        b := NumGet(buf, A_Index - 1, "UChar")
        if (b == 0)
            break
        if (RegExMatch(Chr(b), "[a-zA-Z0-9_.~-]"))
            res .= Chr(b)
        else
            res .= Format("%{:02X}", b)
    }
    return res
}

Base64Encode(str, params*) {
    len := StrPut(str, "UTF-8") - 1
    buf := Buffer(len)
    StrPut(str, buf, "UTF-8")
    outLen := 0
    DllCall("Crypt32.dll\CryptBinaryToStringW", "Ptr", buf, "UInt", len, "UInt", 0x40000001, "Ptr", 0, "UInt*", &outLen)
    outBuf := Buffer(outLen * 2)
    DllCall("Crypt32.dll\CryptBinaryToStringW", "Ptr", buf, "UInt", len, "UInt", 0x40000001, "Ptr", outBuf, "UInt*", &outLen)
    return StrGet(outBuf, "UTF-16")
}
