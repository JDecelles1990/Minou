  "powershell_snippets": [
    { "name": "Get Processes", "code": "Get-Process | Sort-Object CPU -Descending | Select-Object -First 15 Name, Id, CPU, WorkingSet" },
    { "name": "Running Services", "code": "Get-Service | Where-Object Status -eq 'Running' | Sort-Object DisplayName" },
    { "name": "Network Info", "code": "Get-NetIPAddress | Where-Object AddressFamily -eq 'IPv4' | Select-Object InterfaceAlias, IPAddress" },
    { "name": "IP Config", "code": "ipconfig /all" },
    { "name": "Installed Apps", "code": "Get-ItemProperty HKLM:\\Software\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\* | Select-Object DisplayName, DisplayVersion" },
    { "name": "Event Log Query", "code": "Get-EventLog -LogName System -EntryType Error -Newest 10" },
    { "name": "Restart Explorer", "code": "Stop-Process -Name explorer -Force" },
    { "name": "File Search", "code": "Get-ChildItem -Path C:\\ -Filter '*.log' -Recurse -ErrorAction SilentlyContinue" },
    { "name": "Kill Process", "code": "Stop-Process -Name 'ProcessName' -Force" }
  ],
